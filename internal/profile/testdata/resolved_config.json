{
  "$schema": "https://opencode.ai/config.json",
  "username": "bench-user",
  "default_agent": "build",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "agent": {
    "build": {
      "model": "anthropic/claude-sonnet-4-5",
      "variant": "high",
      "temperature": 0.1,
      "steps": 60,
      "prompt": "You are build. This prompt is synthetic test data.",
      "options": {"reasoningEffort": "high"},
      "tools": {"bash": true, "read": true, "edit": true}
    },
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-5",
      "steps": 20,
      "permission": {"edit": "ask"}
    }
  },
  "permission": {"bash": "ask", "edit": "allow"},
  "mcp": {
    "gitlab": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.example.invalid/v2/mcp",
      "headers": {"Authorization": "Bearer gitlab-pat-EXAMPLE-not-real"},
      "environment": {
        "GITLAB_TOKEN": "glpat-EXAMPLE-not-real",
        "GITLAB_HOST": "https://gitlab.example.invalid"
      }
    },
    "local-tool": {
      "type": "local",
      "enabled": false,
      "command": ["node", "/home/u/tools/mcp.js"],
      "environment": {"SAFE_VAR": "visible"}
    }
  },
  "plugin": [
    "file:///home/u/.config/opencode/plugins/hello.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "plugin_origins": {
    "file:///home/u/.config/opencode/plugins/hello.js": "/home/u/.config/opencode/plugins/hello.js"
  },
  "skills": {"paths": ["/home/u/.agents/skills"]},
  "provider": {
    "anthropic": {
      "options": {"timeout": 600000},
      "models": {"claude-sonnet-4-5": {"limit": {"context": 200000}}}
    }
  },
  "command": {
    "review": {"description": "Review the current diff", "template": "Review {{args}}"}
  }
}
